{
  "name": "backend",
  "version": "1.0.0",
  "description": "CRM backend API",
  "type": "module",
  "main": "src/index.mts",
  "scripts": {
    "dev": "tsx watch src/index.mts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:init": "tsx src/init-db.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "better-auth": "^1.7.10",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
